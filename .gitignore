# ====================================
# KAN-4: Test Execution Artifacts
# Screenshots/Traces created at runtime
# Only track folder structure (.gitkeep)
# ====================================
PlaywrightTests/TestResults/HtmlReports/*.html
PlaywrightTests/TestResults/HtmlReports/*.htm
PlaywrightTests/TestResults/HtmlReports/Screenshots/*.png
PlaywrightTests/TestResults/HtmlReports/Screenshots/*.jpg
PlaywrightTests/TestResults/HtmlReports/Traces/*.zip

# Keep folder structure tracked in Git
!PlaywrightTests/TestResults/HtmlReports/.gitkeep
!PlaywrightTests/TestResults/HtmlReports/Screenshots/.gitkeep
!PlaywrightTests/TestResults/HtmlReports/Traces/.gitkeep

# NUnit test results
*.trx
TestResults/*.xml

# ====================================
# NUnit HTML Report (generated output)
# ====================================
PlaywrightTests/TestResults/HtmlReports/TestReport.html
PlaywrightTests/TestResults/HtmlReports/TestReport_*.html

# ====================================
# Build outputs
# ====================================
[Bb]in/
[Oo]bj/
*.user
.vs/
*.suo

# ====================================
# NuGet packages
# ====================================
packages/
*.nupkg

# ====================================
# OS files
# ====================================
.DS_Store
Thumbs.db
desktop.ini

# ====================================
# IDE files
# ====================================
.idea/
*.swp
*.swo